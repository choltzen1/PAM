# T-Mobile PAM Application Environment Configuration
# Copy this file to .env and update the values for your environment

# Flask Environment
FLASK_ENV=development
# FLASK_ENV=production  # Uncomment for production

# Authentication Configuration
TMOBILE_AUTH_ENABLED=true
# TMOBILE_BYPASS_AUTH=true  # Uncomment for development without Zscaler

# Zscaler Header Configuration
# These headers should match what Zscaler provides in your environment
ZSCALER_USER_HEADER=X-Authenticated-User
ZSCALER_EMAIL_HEADER=X-User-Email
ZSCALER_GROUPS_HEADER=X-User-Groups
ZSCALER_DEPT_HEADER=X-User-Department

# Database Configuration
PAM_DATABASE_URL=sqlite:///pam.db
ORBIT_CONNECTION_STRING=your_orbit_connection_string_here

# Security Configuration
PAM_SECRET_KEY=tmobile-pam-production-key-change-in-prod

# Audit Logging
PAM_AUDIT_LOG=logs/pam_audit.log

# JIRA Configuration for T-Mobile PAM Application
JIRA_URL=https://t-mobile.atlassian.net
JIRA_USERNAME=your-email@t-mobile.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECT=CPO
JIRA_R2D2_TEAM_ID=14013

# JIRA Project Settings
JIRA_DEFAULT_ISSUE_TYPE=Task
JIRA_DEFAULT_PRIORITY=High
JIRA_DEFAULT_ASSIGNEE=your-email@t-mobile.com

# Parent Ticket Configuration (Update monthly for DCD using update_dcd_ticket.py)
JIRA_DCD_CURRENT_TICKET=DCOMM-13037

# JIRA Project Settings
JIRA_DEFAULT_ISSUE_TYPE=Task
JIRA_DEFAULT_PRIORITY=High
JIRA_DEFAULT_ASSIGNEE=your-email@t-mobile.com

# JIRA Labels and Components (comma-separated)
JIRA_LABELS=PAM,Promotion,BPTCR
JIRA_COMPONENTS=Promotion Management

# JIRA Connection Settings
JIRA_TIMEOUT=30
JIRA_VERIFY_SSL=false
DEBUG_JIRA=true

# Performance Settings
CACHE_TIMEOUT=3600
MAX_UPLOAD_SIZE=16777216

# Development Settings (remove in production)
DEBUG=false
